{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Sentinel-X (Back + Front)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--port", "4000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/Scripts/python.exe",
      "console": "integratedTerminal",
      "justMyCode": true,
      "preLaunchTask": "Front (Vite)"
    }
  ]
}
