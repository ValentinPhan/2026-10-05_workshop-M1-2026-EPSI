# Copiez ce fichier en backend/.env (ignoré par git) et adaptez. Les variables déjà définies dans l'environnement gagnent.

# Environnement : prod (défaut) ou dev. En dev, AUCUNE photo d'intrusion n'est enregistrée (l'alerte reste créée, sans image).
# APP_ENV=prod

# Base de données. Par défaut : SQLite, un fichier backend/data/sentinel.db (rien à installer).
# PostgreSQL (ex. le conteneur du serveur : il doit publier son port 5432 sur la machine) :
# DATABASE_URL=postgresql+psycopg://sentinel_admin:<mot-de-passe>@127.0.0.1:5432/sentinel

# Premier lancement : compte admin créé s'il n'existe aucun utilisateur.
# Sans ADMIN_PASSWORD, un mot de passe aléatoire est affiché une seule fois dans la console du backend.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Compte agent (consultation seule), créé au démarrage s'il n'existe pas et si AGENT_PASSWORD est renseigné (8 caractères min).
AGENT_USERNAME=agent
# AGENT_PASSWORD=

# Jeton que le Raspberry présente pour envoyer ses images (raspberry-pi/camera_push.py --token ...).
# Vide = le Pi est refusé. Générer : python -c "import secrets; print(secrets.token_urlsafe(24))"
# DEVICE_TOKEN=

# Raspberry Pi réel (sinon PROVIDER=mock, données simulées). Montage et mise en service : raspberry-pi/README.md
# PROVIDER=ssh
# SSH_HOST=192.168.137.x          # IP du Pi sur le hotspot du PC
# SSH_USER=pi
# SSH_KEY=                        # clé privée ; vide = clés par défaut de ~/.ssh (conseillé : ssh-copy-id pi@<IP>)
# SSH_PASSWORD=                   # à éviter, préférer une clé
# SSH_KNOWN_HOSTS=                # vide = ~/.ssh/known_hosts (empreinte du Pi vérifiée) ; none = pas de vérification (tests seulement)
# SSH_COMMAND=python3 -u ~/sentinel-x/raspberry-pi/sentinel_agent.py
# ABSENT_MODULES=thermal          # capteurs non montés : jamais signalés en panne
# AGENT_LOCAL=1                   # sans Raspberry : l'agent tourne sur ce PC en mode simulé

# Durée d'une session (heures) ; COOKIE_SECURE=1 si le dashboard est servi en HTTPS.
# SESSION_HOURS=12
# COOKIE_SECURE=0

# Journal JSON des événements (un fichier par jour, une ligne JSON par événement, avec l'état complet de l'application).
# Voir app/logger.py. Défaut : backend/data/logs/
# LOG_DIR=

# Santé des modules : délai (s) sans snapshot avant de déclarer le Raspberry perdu, et âge max (s) de la dernière mesure DHT22.
# MODULE_TIMEOUT_S=5
# DHT_STALE_S=30

# Relevé périodique dans le journal JSON : une ligne avec toutes les données des capteurs toutes les N secondes (défaut 60).
# MONITOR_INTERVAL_S=60

# Clip vidéo H.264 de chaque intrusion (de la première détection à la fin), en plus des photos.
# auto (défaut) = activé en prod, désactivé en dev ; 1 / 0 pour forcer. Dossier : backend/data/videos/ (VIDEOS_DIR).
# RECORD_VIDEO=auto
# RECORD_PREROLL_S=2      # secondes avant la détection incluses dans le clip
# RECORD_CRF=28           # qualité : 23 (meilleure, plus lourd) à 32 (plus léger)
# RECORD_MAX_WIDTH=640
# RECORD_MAX_S=180        # un clip plus long est coupé en parties
# RECORD_KEEP_MB=1000     # quota : les plus anciens clips sont supprimés au-delà

# Edge Node ESP8266 (gaz MQ-2, présence PIR) via MQTTS — voir docs/mqtt-contract.md.
# EDGE : mqtt (vrai boîtier, broker infra/docker-compose.yml) | mock (simulé ; défaut avec PROVIDER=mock) | off
# EDGE=mqtt
# MQTT_HOST=127.0.0.1
# MQTT_PORT=8883
# Certificats du backend (défaut : infra/pki/out/ca.crt, backend.crt, backend.key, générés par infra/pki/gen-certs.sh)
# MQTT_CA=
# MQTT_CERT=
# MQTT_KEY=
# EDGE_TIMEOUT_S=10       # sans message de l'ESP pendant ce délai : perte de connexion
# GAS_ALERT_RAW=600       # seuil d'alerte gaz (lecture brute 0–1023) : à régler sur le vrai MQ-2
