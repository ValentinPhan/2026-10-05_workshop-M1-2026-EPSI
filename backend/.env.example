# Copiez ce fichier en backend/.env (ignoré par git) et adaptez. Les variables déjà définies dans l'environnement gagnent.

# Base de données. Par défaut : SQLite, un fichier backend/data/sentinel.db (rien à installer).
# PostgreSQL (ex. le conteneur du serveur : il doit publier son port 5432 sur la machine) :
# DATABASE_URL=postgresql+psycopg://sentinel_admin:<mot-de-passe>@127.0.0.1:5432/sentinel

# Premier lancement : compte admin créé s'il n'existe aucun utilisateur.
# Sans ADMIN_PASSWORD, un mot de passe aléatoire est affiché une seule fois dans la console du backend.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=

# Jeton que le Raspberry présente pour envoyer ses images (raspberry-pi/camera_push.py --token ...).
# Vide = le Pi est refusé. Générer : python -c "import secrets; print(secrets.token_urlsafe(24))"
# DEVICE_TOKEN=

# Durée d'une session (heures) ; COOKIE_SECURE=1 si le dashboard est servi en HTTPS.
# SESSION_HOURS=12
# COOKIE_SECURE=0
