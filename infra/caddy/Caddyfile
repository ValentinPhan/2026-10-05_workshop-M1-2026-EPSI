# Caddy — point d'entrée HTTPS unique (port 443).
# "tls internal" : Caddy génère sa propre CA locale (pas d'accès Internet nécessaire).
{
	auto_https disable_redirects
}

https://10.50.0.1, https://sentinel.local {
	tls internal

	handle /api/* {
		reverse_proxy api:8000
	}
	handle /ws* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy dashboard:80
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		-Server
	}
}
